{
  "name": "qotes-server",
  "version": "1.0.0",
  "description": "qotes-server",
  "license": "ISC",
  "author": "rajasekhar",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "SET NODE_ENV=development&&SET ENABLE_FILE_LOGGING=true&&nodemon src/server.js",
    "prod": "SET NODE_ENV=production&&nodemon src/server.js",
    "worker:reaction": "node src/workers/reaction.worker.js",
    "worker:cache": "node src/workers/loginFollowerCache.worker.js",
    "worker:image": "node src/workers/imageGeneration.worker.js",
    "worker:notification": "node src/workers/notification.worker.js",
    "worker:cron": "node src/workers/cron.worker.js",
    "worker:content-sync": "node src/workers/contentSync.worker.js",
    "dlq:replay": "node src/infrastructure/kafka/dlq/universal.dlq.js",
    "kafka:init": "node src/infrastructure/kafka/initTopics.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky "
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^2.0.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "redis": "^5.10.0",
    "sharp": "^0.32.1",
    "uuid": "^14.0.1",
    "winston": "^3.9.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.4"
  }
}
