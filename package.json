{
  "name": "qotes-server",
  "version": "1.0.0",
  "description": "qotes-server",
  "license": "ISC",
  "author": "rajasekhar",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "SET NODE_ENV=development&&SET ENABLE_FILE_LOGGING=true&&nodemon --exec ts-node src/main.ts",
    "prod": "SET NODE_ENV=production&&nodemon --exec ts-node src/main.ts",
    "build": "tsc",
    "worker:reaction": "ts-node src/workers/reaction.worker.ts",
    "worker:cache": "ts-node src/workers/loginFollowerCache.worker.ts",
    "worker:image": "ts-node src/workers/imageGeneration.worker.ts",
    "worker:notification": "ts-node src/workers/notification.worker.ts",
    "worker:cron": "ts-node src/workers/cron.worker.ts",
    "worker:content-sync": "ts-node src/workers/contentSync.worker.ts",
    "dlq:replay": "ts-node src/infrastructure/kafka/dlq/universal.dlq.ts",
    "kafka:init": "ts-node src/infrastructure/kafka/initTopics.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "jest --passWithNoTests",
    "prepare": "husky ",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,css,html}\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.15",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.32.1",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.1",
    "winston": "^3.9.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
